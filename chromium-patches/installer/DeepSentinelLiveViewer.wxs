<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 installer source for DeepSentinel Live Viewer.

  Build via chromium-patches/installer/build-msi.sh, which:
    1. Extracts the portable zip from package.sh into a staging dir
    2. Strips the portable zip's chrome.bat / README / NOTICES (the
       Start Menu shortcut below carries the launch flags itself)
    3. Runs heat.exe to harvest the stage into Harvested.wxs
    4. Runs candle.exe + light.exe against both .wxs files

  Variables passed in via candle -d:
    var.StageDir         path to the staged file tree
    var.ProductVersion   MSI ProductVersion (major.minor.build), e.g.
                         145.0.7632. MSI caps major and minor at < 256,
                         which Chromium's build (7632) and patch (218)
                         do not fit, so we take the first three fields
                         of the Chromium version and drop the patch.
                         AllowSameVersionUpgrades is enabled so respins
                         of the same Chromium build can still upgrade.
    var.DisplayVersion   full Chromium version string for ARP display,
                         e.g. 145.0.7632.218
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="DeepSentinel Live Viewer"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="DeepSentinel"
           UpgradeCode="8A1F9E2D-5C4B-4A3F-9E7D-6B8C0A1F2E3D">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="DeepSentinel Live Viewer (Chromium HEVC SW decode)"
             Comments="Internal-only build. Do not redistribute."
             Manufacturer="DeepSentinel" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ARP (Add/Remove Programs) presentation. ARPDISPLAYVERSION and
         ARPINSTALLLOCATION are set via SetProperty rather than static
         Property because static declarations of these two specifically
         do not reliably override the registry values written by the
         WriteRegistryValues standard action — Windows Installer falls
         back to ProductVersion / empty respectively. SetProperty in the
         InstallExecuteSequence works. The static-Property form is fine
         for the other ARP* properties (NoRepair, NoModify, Contact). -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCONTACT" Value="DeepSentinel internal IT" />
    <SetProperty Id="ARPDISPLAYVERSION"
                 Value="$(var.DisplayVersion)"
                 After="CostFinalize"
                 Sequence="execute" />
    <SetProperty Id="ARPINSTALLLOCATION"
                 Value="[INSTALLFOLDER]"
                 After="CostFinalize"
                 Sequence="execute" />
    <Icon Id="ChromeIcon.exe" SourceFile="$(var.StageDir)\chrome.exe" />
    <Property Id="ARPPRODUCTICON" Value="ChromeIcon.exe" />

    <!-- Layout: C:\Program Files\DeepSentinel\Live Viewer\ -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="DeepSentinelDir" Name="DeepSentinel">
          <Directory Id="INSTALLFOLDER" Name="Live Viewer" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppStartMenuDir" Name="DeepSentinel" />
      </Directory>
    </Directory>

    <!-- Start Menu shortcut. Launches chrome.exe directly; the shell
         expands %LOCALAPPDATA% in the arguments at launch time, so each
         user of this per-machine install gets their own profile.
         disable-component-update kills the only remaining network path
         that might mutate the install. The two renderer-cancellation
         features and disable-hang-monitor keep LSC's long-lived tabs
         from being killed as "unresponsive" under a full 5x2 grid.
         (Matches the MSI shipped to guards on 2026-05-14; the earlier
         live-viewer.bat launcher is gone.) -->
    <DirectoryRef Id="AppStartMenuDir">
      <Component Id="StartMenuShortcutComponent"
                 Guid="A2B3C4D5-E6F7-4890-A1B2-C3D4E5F60718"
                 Win64="yes">
        <Shortcut Id="StartMenuShortcut"
                  Name="DeepSentinel Live Viewer"
                  Description="Internal Chromium build with software HEVC decode"
                  Target="[INSTALLFOLDER]chrome.exe"
                  Arguments="--user-data-dir=&quot;%LOCALAPPDATA%\DeepSentinel\Live Viewer\User Data&quot; --no-default-browser-check --disable-component-update --enable-features=SkipRendererCancellationThrottle,RendererCancellationThrottleImprovements --disable-hang-monitor"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ChromeIcon.exe"
                  IconIndex="0" />
        <RemoveFolder Id="RemoveAppStartMenuDir"
                      Directory="AppStartMenuDir"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\DeepSentinel\Live Viewer"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Belt-and-suspender Google Update policy keys. Our binary does
         not ship Omaha/GoogleUpdate.exe so it has nothing to phone home
         with, but if real Google Chrome ever lands on the same host
         these system-wide policies stop it from trying to update us
         too. WARNING: these policies also block updates of any real
         Google Chrome on the machine; on workstations that mix the two,
         drop UpdatePoliciesComponent from the Feature below. -->
    <DirectoryRef Id="TARGETDIR">
      <Component Id="UpdatePoliciesComponent"
                 Guid="B3C4D5E6-F708-491A-B2C3-D4E5F60718A2"
                 Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Policies\Google\Update">
          <RegistryValue Name="UpdateDefault" Type="integer" Value="0" KeyPath="yes" />
          <RegistryValue Name="InstallDefault" Type="integer" Value="0" />
          <RegistryValue Name="AutoUpdateCheckPeriodMinutes" Type="integer" Value="0" />
        </RegistryKey>
      </Component>
      <!-- DS-2916: force software decode. HardwareAccelerationModeEnabled=0
           is the Chromium policy behind Settings > System > "Use graphics
           acceleration when available". As a machine policy it (a) turns
           the whole GPU path off, including D3D11 HEVC video decode, so
           every H.265 stream goes through our FFmpeg SW decoder no matter
           how chrome.exe is launched, and (b) greys the toggle out
           in Settings so guards cannot flip it back. Our build is not
           Google-branded, so it reads Software\Policies\Chromium, not
           Software\Policies\Google\Chrome: real Chrome on the same host
           is unaffected. -->
      <Component Id="ChromiumPolicyComponent"
                 Guid="D5E6F708-192A-4B3C-D4E5-F60718A2B3C4"
                 Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Policies\Chromium">
          <RegistryValue Name="HardwareAccelerationModeEnabled" Type="integer" Value="0" KeyPath="yes" />
        </RegistryKey>
      </Component>
      <Component Id="ProductIdentificationComponent"
                 Guid="C4D5E6F7-0819-4A2B-C3D4-E5F60718A2B3"
                 Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\DeepSentinel\Live Viewer">
          <RegistryValue Name="Version" Type="string" Value="$(var.DisplayVersion)" KeyPath="yes" />
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="DeepSentinel Live Viewer" Level="1">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="UpdatePoliciesComponent" />
      <ComponentRef Id="ChromiumPolicyComponent" />
      <ComponentRef Id="ProductIdentificationComponent" />
    </Feature>

  </Product>
</Wix>
